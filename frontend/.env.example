# =============================================================================
# MiningNiti Frontend — Environment Variables
#
# Copy to .env.local and fill in your values:   cp .env.example .env.local
#
# IMPORTANT: anything prefixed NEXT_PUBLIC_ is compiled into the JavaScript
# bundle the browser downloads. It is public by definition — never put a secret
# behind that prefix. On Vercel, do not mark NEXT_PUBLIC_* variables as
# "Sensitive" either: it protects nothing (they ship to the browser anyway) and
# it stops you reading the value back to check it.
#
# Next.js inlines these at BUILD time. Changing a value on Vercel does nothing
# until you redeploy.
# =============================================================================


# =============================================================================
# BACKEND API
# =============================================================================
# Base URL of the FastAPI backend. No trailing slash — the client appends
# /api/v1 itself.
#
#   local development : http://localhost:8000
#   HuggingFace Space : https://<owner>-<space-name>.hf.space
#
# The Space hostname is your Space ID with the '/' replaced by '-', so
# milan1/miningniti-api becomes milan1-miningniti-api.hf.space
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000


# =============================================================================
# AUTHENTICATION — Clerk
# =============================================================================
# Read automatically by @clerk/nextjs; they are not referenced directly in the
# source, so do not remove them because a grep finds nothing.
#
# pk_test_/sk_test_ are development-instance keys: capped user count and a
# "development mode" banner. Use pk_live_/sk_live_ for real traffic.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# The only genuinely secret value here. Server-side only, never exposed to the
# browser. Mark this one as Sensitive on Vercel.
CLERK_SECRET_KEY=sk_test_your_secret_key_here

# Where Clerk's sign-in / sign-up pages live in this app.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Where to land after authenticating, when there is no redirect target.
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard


# =============================================================================
# REMOVED — do not re-add
# =============================================================================
# UPLOADTHING_TOKEN   uploads go directly to the backend; nothing reads this
# CLERK_FRONTEND_API  legacy (Clerk v4). v6 derives it from the publishable key
