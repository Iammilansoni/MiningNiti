# =============================================================================
# MiningNiti Backend — Environment Variables
#
# Copy to .env and fill in your values:   cp .env.example .env
#
# Anything under "REQUIRED" has no default. If it is missing, Settings raises a
# ValidationError at import and the application does not start at all.
# =============================================================================


# =============================================================================
# REQUIRED — the app will not boot without these
# =============================================================================

# PostgreSQL with the pgvector extension.
#   Supabase: use the *Transaction pooler* string (port 6543), not 5432.
#   The driver prefix is optional — postgresql://, postgresql+psycopg2:// and
#   postgresql+psycopg:// are all accepted and normalised internally.
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# Google Gemini — used for embeddings and the compliance auditor.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq — classifier agent and RAG chat generation.
# https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Mistral — safety analyzer agent.
# https://console.mistral.ai
MISTRAL_API_KEY=your_mistral_api_key_here

# Clerk JWKS endpoint, used to verify session tokens.
# Found in your Clerk dashboard, or derived from your publishable key.
CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json


# =============================================================================
# STRONGLY RECOMMENDED — the app starts without these, but features degrade
# =============================================================================

# Cerebras — entity extractor and summarizer agents. Those two agents fail
# without it; the rest of the pipeline still works.
# https://cloud.cerebras.ai
CEREBRAS_API_KEY=your_cerebras_api_key_here

# Redis — caches the analytics dashboard for 60s. Everything works without it,
# the dashboard just queries the database each time.
# Upstash requires ?tls=true on the URL.
REDIS_URL=redis://localhost:6379/0


# =============================================================================
# SECURITY — set these in production
# =============================================================================

# Origins allowed to call this API, as a JSON array. Wildcards do NOT work
# here: these are compared as exact strings. Use CORS_ORIGIN_REGEX for patterns.
# No trailing slashes.
CORS_ORIGINS=["https://your-app.vercel.app","http://localhost:3000"]

# Regex for dynamic origins, e.g. Vercel preview deployments. Scope it to your
# own project — a bare '.*\.vercel\.app' would let any site hosted on Vercel
# call this API with credentials.
# NOTE: HuggingFace Spaces puts a proxy in front of the app that reflects any
# Origin, so CORS is not enforceable there. It applies when self-hosting.
CORS_ORIGIN_REGEX=^https://your-app-[a-z0-9-]+\.vercel\.app$

# Allowed 'azp' (authorized party) claim values — your frontend origins, as a
# JSON array. Clerk records which site requested a token in this claim.
# Without this check, a token minted for ANY other application on the same
# Clerk instance is accepted here: same signature, same issuer, different azp.
# Leaving it empty logs a warning on every boot and skips the check.
CLERK_AUTHORIZED_PARTIES=["https://your-app.vercel.app","http://localhost:3000"]

# Expected 'iss' claim. Leave blank to derive it from CLERK_JWKS_URL, which is
# correct for standard Clerk setups.
CLERK_ISSUER=

# Optional: path to a CA certificate for the database connection.
# SSL_CERT_PATH=config/prod-ca-2021.crt


# =============================================================================
# APPLICATION
# =============================================================================
APP_NAME=MiningNiti
APP_VERSION=2.0.0
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Gunicorn workers. Each one loads its own copy of the cross-encoder
# (~400MB with torch), so raise this only if you have the memory.
GUNICORN_WORKERS=2


# =============================================================================
# DOCUMENT PROCESSING
# =============================================================================
MAX_FILE_SIZE_MB=50

# Where uploaded files are stored. All storage:// URLs resolve inside this
# directory and cannot escape it.
# UPLOAD_DIR=/app/uploads

# Durable object storage for uploaded files. UPLOAD_DIR lives on the container
# filesystem, which is ephemeral on HuggingFace Spaces: without these, every
# uploaded file is lost on restart while its database row survives, and the
# document later fails with "Stored file no longer exists". Set URL and
# SERVICE_KEY together to store the bytes in Supabase instead; leave both blank
# to keep the local-disk behaviour, which is fine for local development.
# The bucket must be created as a *private* bucket in the Supabase dashboard —
# the service role key, not the anon key, is what reads from it.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
SUPABASE_STORAGE_BUCKET=documents

# Chunking. CHUNK_SIZE/OVERLAP are in words; MAX_CHUNK_CHARS is a hard
# character ceiling applied afterwards, because a Markdown table contains no
# sentence boundaries and would otherwise be emitted at any size — a 400-row
# table produced a single 14,703-character chunk, well over the embedding
# model's input limit.
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_CHUNK_CHARS=4000

# Table extraction via pdfplumber. Mining regulations and equipment manuals are
# largely tabular, and flat text extraction destroys the row/column structure.
ENABLE_TABLE_EXTRACTION=true

# OCR for scanned pages. Requires the tesseract-ocr and poppler-utils system
# packages (installed in the Dockerfile). Degrades to a warning if absent.
ENABLE_OCR=true
OCR_MIN_CHARS=100
OCR_LANGUAGE=eng
OCR_DPI=200
OCR_MAX_PAGES=50


# =============================================================================
# AI MODELS
# =============================================================================
# NOTE: chat generation runs on Groq (chat_service.CHAT_MODEL), not Gemini.
# GEMINI_MODEL is read by the RAG generation-eval judge, so it must point at a
# live model. gemini-1.5-flash and gemini-2.5-flash are superseded; 3.7-flash is
# the current stable Flash.
GEMINI_MODEL=gemini-3.7-flash
EMBEDDING_MODEL=models/gemini-embedding-001


# =============================================================================
# RETRIEVAL
# =============================================================================
# Hybrid search: pgvector cosine similarity fused with PostgreSQL full-text
# search (ts_rank_cd over a GIN-indexed tsvector) via Reciprocal Rank Fusion.
ENABLE_HYBRID_SEARCH=true
ENABLE_RERANKING=true

RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_OVER_FETCH=20
RERANK_TOP_K=5
SIMILARITY_THRESHOLD=0.25
RRF_K=60
MAX_EMBEDDINGS_PER_QUERY=5

SAFETY_SCORE_THRESHOLD=70.0


# =============================================================================
# OBSERVABILITY — optional
# =============================================================================
# Set LANGCHAIN_TRACING_V2=true to activate LangSmith tracing.
# https://smith.langchain.com/settings
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=miningniti
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
